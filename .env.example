# ========== Server Configuration ==========
PORT=5000
NODE_ENV=development

# ========== Database ==========
# MongoDB connection string
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/job-portal?retryWrites=true&w=majority

# ========== JWT Configuration ==========
JWT_SECRET=your-super-secret-jwt-key-here

# ========== Affinda API (Resume & JD Parsing) ==========
# Get API key from: https://www.affinda.com/
# If not set, the system automatically falls back to pdf-parse
AFFINDA_API_KEY=your-affinda-api-key-here

# ========== Google Generative AI (Optional - for other features) ==========
GEMINI_API_KEY=your-gemini-api-key-here

# ========== CORS Origins ==========
CORS_ORIGINS=https://jobwallah.vercel.app,http://localhost:5173,http://localhost:5174

# ========== File Upload Configuration ==========
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=uploads

# ========== Sentence Transformers Configuration ==========
# Model: all-MiniLM-L6-v2 (downloaded automatically on first use)
# Cache location: ~/.cache/huggingface/hub/
MODEL_NAME=Xenova/all-MiniLM-L6-v2
